{
  "name": "@epom-rnd/postscribe",
  "description": "Asynchronously write javascript, even with document.write. Maintained fork by Epom.",
  "homepage": "https://github.com/epom/postscribe",
  "bugs": {
    "url": "https://github.com/epom/postscribe/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/epom/postscribe.git"
  },
  "keywords": [
    "document.write",
    "tag writer",
    "asynchronous",
    "javascript",
    "after load"
  ],
  "author": {
    "name": "Epom",
    "url": "https://epom.com"
  },
  "maintainers": [
    {
      "name": "Anton Ruin",
      "web": "https://github.com/ruin"
    },
    {
      "name": "Epom",
      "web": "https://epom.com"
    }
  ],
  "main": "dist/postscribe.js",
  "browser": "dist/postscribe.js",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "eslint": "^10.13.0",
    "expect.js": "^0.3.1",
    "globals": "^17.13.0",
    "google-closure-compiler-java": "20240317.0.0",
    "jquery": "^3.7.1",
    "playwright": "^1.64.1",
    "rollup": "^4.64.12",
    "sinon": "^22.1.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "rollup -c",
    "lint": "eslint . && tsc -p test/types",
    "test": "web-test-runner",
    "test:check": "node test/epom/postscribe-check.cjs dist/postscribe.js && node test/epom/postscribe-check.cjs dist/postscribe.min.js",
    "test:closure": "java -cp node_modules/google-closure-compiler-java/compiler.jar test/epom/ClosureCheck.java dist/postscribe.js",
    "verify": "npm run lint && npm run build && git diff --exit-code -- dist && npm test && npm run test:check && npm run test:closure",
    "test:differential": "DIFFERENTIAL=1 web-test-runner"
  },
  "version": "3.1.1",
  "module": "src/main.js",
  "unpkg": "dist/postscribe.min.js",
  "jsdelivr": "dist/postscribe.min.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "src/",
    "postscribe.d.ts",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "contributors": [
    {
      "name": "Derek Brans",
      "url": "https://github.com/dbrans"
    },
    {
      "name": "Krux Digital, Inc."
    }
  ],
  "types": "postscribe.d.ts",
  "exports": {
    ".": {
      "types": "./postscribe.d.ts",
      "import": "./dist/postscribe.mjs",
      "require": "./dist/postscribe.js",
      "default": "./dist/postscribe.js"
    },
    "./package.json": "./package.json"
  }
}
